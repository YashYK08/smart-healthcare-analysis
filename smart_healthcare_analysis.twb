<?xml version='1.0' encoding='utf-8' ?>
<workbook original-version='18.1' source-build='2026.2.0' source-platform='win' version='18.1' xmlns:user='http://www.tableausoftware.com/xml/user'>
  <document-format-change-manifest>
    <AccessibleZoneTabOrder />
    <AnimationOnByDefault />
    <AutoCreateAndUpdateDSDPhoneViews />
    <SheetIdentifierTracking />
    <WindowsPersistSimpleIdentifiers />
  </document-format-change-manifest>
  <preferences>
    <preference name='ui.encoding.shelf.height' value='24' />
    <preference name='ui.shelf.height' value='26' />
  </preferences>
  <datasources>
    <datasource caption='smart_healthcare_dataset_cleaned' inline='true' name='federated.smart_healthcare_cleaned' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='smart_healthcare_dataset_cleaned' name='textscan.smart_healthcare_csv'>
            <connection class='textscan' directory='.' filename='smart_healthcare_dataset_cleaned.csv' password='' server='' />
          </named-connection>
        </named-connections>
        <relation connection='textscan.smart_healthcare_csv' name='smart_healthcare_dataset_cleaned.csv' table='[smart_healthcare_dataset_cleaned#csv]' type='table'>
          <columns character-set='UTF-8' header='yes' locale='en_US' separator=','>
            <column datatype='string' name='patient_id' ordinal='0' />
            <column datatype='integer' name='age' ordinal='1' />
            <column datatype='string' name='age_group' ordinal='2' />
            <column datatype='string' name='gender' ordinal='3' />
            <column datatype='real' name='bmi' ordinal='4' />
            <column datatype='string' name='bmi_category' ordinal='5' />
            <column datatype='integer' name='exercise_level' ordinal='6' />
            <column datatype='string' name='exercise_category' ordinal='7' />
            <column datatype='integer' name='smoking' ordinal='8' />
            <column datatype='string' name='smoking_status' ordinal='9' />
            <column datatype='integer' name='alcohol' ordinal='10' />
            <column datatype='string' name='alcohol_status' ordinal='11' />
            <column datatype='integer' name='blood_pressure' ordinal='12' />
            <column datatype='string' name='bp_category' ordinal='13' />
            <column datatype='integer' name='cholesterol' ordinal='14' />
            <column datatype='string' name='cholesterol_category' ordinal='15' />
            <column datatype='integer' name='glucose' ordinal='16' />
            <column datatype='string' name='glucose_category' ordinal='17' />
            <column datatype='integer' name='fatigue' ordinal='18' />
            <column datatype='integer' name='chest_pain' ordinal='19' />
            <column datatype='integer' name='dizziness' ordinal='20' />
            <column datatype='integer' name='symptom_count' ordinal='21' />
            <column datatype='integer' name='heart_disease' ordinal='22' />
            <column datatype='integer' name='diabetes' ordinal='23' />
            <column datatype='integer' name='stroke' ordinal='24' />
            <column datatype='integer' name='chronic_disease_count' ordinal='25' />
            <column datatype='integer' name='has_comorbidity' ordinal='26' />
            <column datatype='real' name='health_risk_score' ordinal='27' />
            <column datatype='real' name='calibrated_risk_score' ordinal='28' />
            <column datatype='string' name='risk_tier' ordinal='29' />
            <column datatype='integer' name='risk_tier_code' ordinal='30' />
          </columns>
        </relation>
      </connection>
      <aliases enabled='yes' />
      <column caption='Patient ID' datatype='string' name='[patient_id]' role='dimension' type='nominal' />
      <column caption='Age' datatype='integer' name='[age]' role='dimension' type='quantitative' />
      <column caption='Age Group' datatype='string' name='[age_group]' role='dimension' type='nominal' />
      <column caption='Gender' datatype='string' name='[gender]' role='dimension' type='nominal' />
      <column caption='BMI' datatype='real' name='[bmi]' role='measure' type='quantitative' />
      <column caption='BMI Category' datatype='string' name='[bmi_category]' role='dimension' type='nominal' />
      <column caption='Exercise Category' datatype='string' name='[exercise_category]' role='dimension' type='nominal' />
      <column caption='Smoking Status' datatype='string' name='[smoking_status]' role='dimension' type='nominal' />
      <column caption='Alcohol Status' datatype='string' name='[alcohol_status]' role='dimension' type='nominal' />
      <column caption='Blood Pressure (mmHg)' datatype='integer' name='[blood_pressure]' role='measure' type='quantitative' />
      <column caption='BP Category' datatype='string' name='[bp_category]' role='dimension' type='nominal' />
      <column caption='Cholesterol (mg/dL)' datatype='integer' name='[cholesterol]' role='measure' type='quantitative' />
      <column caption='Cholesterol Category' datatype='string' name='[cholesterol_category]' role='dimension' type='nominal' />
      <column caption='Fasting Glucose (mg/dL)' datatype='integer' name='[glucose]' role='measure' type='quantitative' />
      <column caption='Glucose Category' datatype='string' name='[glucose_category]' role='dimension' type='nominal' />
      <column caption='Heart Disease' datatype='integer' name='[heart_disease]' role='measure' type='quantitative' />
      <column caption='Diabetes' datatype='integer' name='[diabetes]' role='measure' type='quantitative' />
      <column caption='Stroke' datatype='integer' name='[stroke]' role='measure' type='quantitative' />
      <column caption='Symptom Count' datatype='integer' name='[symptom_count]' role='measure' type='quantitative' />
      <column caption='Chronic Disease Count' datatype='integer' name='[chronic_disease_count]' role='measure' type='quantitative' />
      <column caption='Comorbidity Flag' datatype='integer' name='[has_comorbidity]' role='dimension' type='nominal' />
      <column caption='Raw Risk Score (Constant 100.0)' datatype='real' name='[health_risk_score]' role='measure' type='quantitative' />
      <column caption='Calibrated Risk Score' datatype='real' name='[calibrated_risk_score]' role='measure' type='quantitative' />
      <column caption='Risk Tier' datatype='string' name='[risk_tier]' role='dimension' type='nominal' />
      <column caption='Calculated Risk Level' datatype='string' name='[Calculated_Risk_Level]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [calibrated_risk_score] &lt; 35 THEN &quot;Low&quot; ELSEIF [calibrated_risk_score] &lt; 55 THEN &quot;Moderate&quot; ELSEIF [calibrated_risk_score] &lt; 75 THEN &quot;High&quot; ELSE &quot;Critical&quot; END' />
      </column>
      <column caption='Cardiovascular Risk Flag' datatype='string' name='[Cardiovascular_Risk_Flag]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [blood_pressure] &gt;= 140 OR [cholesterol] &gt;= 240 THEN &quot;Elevated CVD Risk&quot; ELSE &quot;Normal CVD Risk&quot; END' />
      </column>
      <column caption='Metabolic Syndrome Marker' datatype='string' name='[Metabolic_Syndrome_Marker]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [bmi] &gt;= 30.0 AND [glucose] &gt;= 126 AND [blood_pressure] &gt;= 130 THEN &quot;High Metabolic Risk&quot; ELSE &quot;Standard Profile&quot; END' />
      </column>
      <layout dim-ordering='alphabetic' dim-percentage='0.5' measure-ordering='alphabetic' measure-percentage='0.5' show-structure='true' />
      <semantic-values>
        <semantic-value key='[Country].[Name]' value='&quot;United States&quot;' />
      </semantic-values>
    </datasource>
  </datasources>
  <worksheets>
    <worksheet name='KPI_Cohort_Summary'>
      <table>
        <view>
          <datasources>
            <datasource caption='smart_healthcare_dataset_cleaned' name='federated.smart_healthcare_cleaned' />
          </datasources>
          <aggregation value='true' />
        </view>
        <style />
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Automatic' />
          </pane>
        </panes>
        <rows>[federated.smart_healthcare_cleaned].[avg:calibrated_risk_score:qk]</rows>
        <cols>[federated.smart_healthcare_cleaned].[none:risk_tier:nk]</cols>
      </table>
      <simple-id uuid='worksheet_kpi_summary' />
    </worksheet>
    <worksheet name='Disease_Prevalence_by_Age'>
      <table>
        <view>
          <datasources>
            <datasource caption='smart_healthcare_dataset_cleaned' name='federated.smart_healthcare_cleaned' />
          </datasources>
          <aggregation value='true' />
        </view>
        <style />
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Bar' />
          </pane>
        </panes>
        <rows>[federated.smart_healthcare_cleaned].[avg:heart_disease:qk]</rows>
        <cols>[federated.smart_healthcare_cleaned].[none:age_group:nk]</cols>
      </table>
      <simple-id uuid='worksheet_disease_by_age' />
    </worksheet>
    <worksheet name='Risk_Tier_Distribution'>
      <table>
        <view>
          <datasources>
            <datasource caption='smart_healthcare_dataset_cleaned' name='federated.smart_healthcare_cleaned' />
          </datasources>
          <aggregation value='true' />
        </view>
        <style />
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Bar' />
          </pane>
        </panes>
        <rows>[federated.smart_healthcare_cleaned].[cnt:patient_id:qk]</rows>
        <cols>[federated.smart_healthcare_cleaned].[none:risk_tier:nk]</cols>
      </table>
      <simple-id uuid='worksheet_risk_tier_dist' />
    </worksheet>
    <worksheet name='Biomarker_Surveillance_BP_vs_Glucose'>
      <table>
        <view>
          <datasources>
            <datasource caption='smart_healthcare_dataset_cleaned' name='federated.smart_healthcare_cleaned' />
          </datasources>
          <aggregation value='false' />
        </view>
        <style />
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Circle' />
          </pane>
        </panes>
        <rows>[federated.smart_healthcare_cleaned].[none:glucose:qk]</rows>
        <cols>[federated.smart_healthcare_cleaned].[none:blood_pressure:qk]</cols>
      </table>
      <simple-id uuid='worksheet_biomarker_surveillance' />
    </worksheet>
    <worksheet name='Lifestyle_Risk_Matrix'>
      <table>
        <view>
          <datasources>
            <datasource caption='smart_healthcare_dataset_cleaned' name='federated.smart_healthcare_cleaned' />
          </datasources>
          <aggregation value='true' />
        </view>
        <style />
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Square' />
          </pane>
        </panes>
        <rows>[federated.smart_healthcare_cleaned].[none:smoking_status:nk]</rows>
        <cols>[federated.smart_healthcare_cleaned].[none:exercise_category:nk]</cols>
      </table>
      <simple-id uuid='worksheet_lifestyle_matrix' />
    </worksheet>
    <worksheet name='Comorbidity_Burden'>
      <table>
        <view>
          <datasources>
            <datasource caption='smart_healthcare_dataset_cleaned' name='federated.smart_healthcare_cleaned' />
          </datasources>
          <aggregation value='true' />
        </view>
        <style />
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Bar' />
          </pane>
        </panes>
        <rows>[federated.smart_healthcare_cleaned].[cnt:patient_id:qk]</rows>
        <cols>[federated.smart_healthcare_cleaned].[none:chronic_disease_count:ok]</cols>
      </table>
      <simple-id uuid='worksheet_comorbidity_burden' />
    </worksheet>
    <worksheet name='Symptom_Cluster_Analysis'>
      <table>
        <view>
          <datasources>
            <datasource caption='smart_healthcare_dataset_cleaned' name='federated.smart_healthcare_cleaned' />
          </datasources>
          <aggregation value='true' />
        </view>
        <style />
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Bar' />
          </pane>
        </panes>
        <rows>[federated.smart_healthcare_cleaned].[avg:symptom_count:qk]</rows>
        <cols>[federated.smart_healthcare_cleaned].[none:risk_tier:nk]</cols>
      </table>
      <simple-id uuid='worksheet_symptom_cluster' />
    </worksheet>
    <worksheet name='BMI_vs_Cholesterol_Scatter'>
      <table>
        <view>
          <datasources>
            <datasource caption='smart_healthcare_dataset_cleaned' name='federated.smart_healthcare_cleaned' />
          </datasources>
          <aggregation value='false' />
        </view>
        <style />
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Circle' />
          </pane>
        </panes>
        <rows>[federated.smart_healthcare_cleaned].[none:cholesterol:qk]</rows>
        <cols>[federated.smart_healthcare_cleaned].[none:bmi:qk]</cols>
      </table>
      <simple-id uuid='worksheet_bmi_cholesterol' />
    </worksheet>
  </worksheets>
  <dashboards>
    <dashboard name='Clinical_Risk_and_Biomarker_Dashboard'>
      <style />
      <size maxheight='850' maxwidth='1200' minheight='850' minwidth='1200' sizing-mode='fixed' />
      <zones>
        <zone h='100000' id='1' type-v2='layout-basic' w='100000' x='0' y='0'>
          <zone h='50000' id='2' name='KPI_Cohort_Summary' w='50000' x='0' y='0' />
          <zone h='50000' id='3' name='Disease_Prevalence_by_Age' w='50000' x='50000' y='0' />
          <zone h='50000' id='4' name='Biomarker_Surveillance_BP_vs_Glucose' w='50000' x='0' y='50000' />
          <zone h='50000' id='5' name='Risk_Tier_Distribution' w='50000' x='50000' y='50000' />
        </zone>
      </zones>
      <simple-id uuid='dashboard_clinical_risk' />
    </dashboard>
    <dashboard name='Population_Health_and_Lifestyle_Matrix'>
      <style />
      <size maxheight='850' maxwidth='1200' minheight='850' minwidth='1200' sizing-mode='fixed' />
      <zones>
        <zone h='100000' id='10' type-v2='layout-basic' w='100000' x='0' y='0'>
          <zone h='50000' id='11' name='Lifestyle_Risk_Matrix' w='50000' x='0' y='0' />
          <zone h='50000' id='12' name='Comorbidity_Burden' w='50000' x='50000' y='0' />
          <zone h='50000' id='13' name='Symptom_Cluster_Analysis' w='50000' x='0' y='50000' />
          <zone h='50000' id='14' name='BMI_vs_Cholesterol_Scatter' w='50000' x='50000' y='50000' />
        </zone>
      </zones>
      <simple-id uuid='dashboard_population_health' />
    </dashboard>
    <dashboard name='Healthcare_Risk_and_Disease_Story'>
      <style />
      <size maxheight='900' maxwidth='1280' minheight='900' minwidth='1280' sizing-mode='fixed' />
      <zones>
        <zone h='100000' id='20' type-v2='layout-basic' w='100000' x='0' y='0'>
          <zone h='100000' id='21' name='Clinical_Risk_and_Biomarker_Dashboard' w='100000' x='0' y='0' />
        </zone>
      </zones>
      <simple-id uuid='dashboard_story' />
    </dashboard>
  </dashboards>
  <windows>
    <window class='worksheet' maximized='true' name='KPI_Cohort_Summary'>
      <cards>
        <edge name='left'>
          <strip size='160'>
            <card type='pages' />
            <card type='filters' />
            <card type='marks' />
          </strip>
        </edge>
        <edge name='top'>
          <strip size='31'>
            <card type='columns' />
          </strip>
          <strip size='31'>
            <card type='rows' />
          </strip>
        </edge>
      </cards>
      <simple-id uuid='window_kpi' />
    </window>
    <window class='dashboard' name='Clinical_Risk_and_Biomarker_Dashboard'>
      <viewpoints />
      <active id='-1' />
      <simple-id uuid='window_dash1' />
    </window>
    <window class='dashboard' name='Population_Health_and_Lifestyle_Matrix'>
      <viewpoints />
      <active id='-1' />
      <simple-id uuid='window_dash2' />
    </window>
    <window class='dashboard' name='Healthcare_Risk_and_Disease_Story'>
      <viewpoints />
      <active id='-1' />
      <simple-id uuid='window_story' />
    </window>
  </windows>
</workbook>
